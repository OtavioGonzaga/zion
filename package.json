{
	"name": "zion",
	"version": "0.3.1",
	"private": true,
	"description": "A local-first Bible reading plan companion.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"typecheck": "tsc -b --pretty false",
		"test": "vitest run",
		"release:prepare": "bun scripts/release/prepare.ts",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "bun run build && playwright test"
	},
	"dependencies": {
		"lucide-react": "1.52.0",
		"react": "19.2.3",
		"react-dom": "19.2.3"
	},
	"devDependencies": {
		"@playwright/test": "1.58.1",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"@vitest/coverage-v8": "4.0.16",
		"jsdom": "27.1.0",
		"oxfmt": "0.27.0",
		"oxlint": "1.32.0",
		"typescript": "5.9.3",
		"vite": "8.0.16",
		"vitest": "4.0.16"
	},
	"engines": {
		"bun": "1.4.2"
	},
	"packageManager": "bun@1.4.2"
}
